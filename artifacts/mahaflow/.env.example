# Public browser configuration. Set these in Replit Secrets for preview
# and in Vercel Project Settings → Environment Variables for deployment.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Optional: the separately deployed API server used by signup Turnstile verification.
VITE_BACKEND_URL=

# Never put the Turnstile secret in this file or in VITE_* variables.
# TURNSTILE_SECRET_KEY belongs only on the server that verifies Turnstile tokens.